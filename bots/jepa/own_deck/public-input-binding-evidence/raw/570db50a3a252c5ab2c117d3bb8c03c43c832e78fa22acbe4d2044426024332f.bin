"""Field-copy dashboard views and an explicit evidence-copy list; no science calls.

This stdlib-only tool reads completed immutable artifacts. It never imports the
interpreter, checker, collector, model, accounting runner, or publication code.
It copies saved measurements and derives only reservation/accounting sums.
The separate immutable exporter consumes export-artifacts.json after review.
"""
import argparse
import hashlib
import json
from pathlib import Path


EXPECTED_AUDIT = "dc42bb849c8531c0df47ded7503536f0da66b5f9a039d750738b0471dc82b39c"
EXPECTED_REPORT = "a217069922f956f3f264fd7779ad354e65d851da73fa4763932c58111a1a8ea3"
EXPECTED_LEDGER = "7e23b61f5defc3f07199b87693dcfc36a4a80e3ca8f795a473e8c0d8bf7ede05"
EXPECTED_CHAIN = "3b52469f736894260f3cdb6494231d278526924cd6ba78e18e0277d97f15d0e1"
EXPECTED_SUPP_CHAIN = "f42dd06ac438739ead55d1cae05faa7d477b7bbd51e9b00c7be12fc073365b45"
SCIENCE = ("data", "scores", "causal-pairs", "encoding-controls", "contract",
           "verification", "accounting", "failures")


def encoded(value):
    return (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False,
                       allow_nan=False) + "\n").encode()


def pin(path):
    path = Path(path).resolve(strict=True)
    raw = path.read_bytes()
    return dict(path=str(path), sha256=hashlib.sha256(raw).hexdigest(), bytes=len(raw))


def load(path):
    return json.loads(Path(path).read_text(), parse_constant=lambda v: fail("nonfinite JSON: " + v))


def fail(message):
    raise ValueError(message)


def require(value, message):
    if not value:
        fail(message)


def verify_pin(expected, base):
    path = Path(expected["path"])
    if not path.is_absolute():
        path = Path(base) / path
    actual = pin(path)
    require(actual["sha256"] == expected["sha256"], "changed source pin: " + str(path))
    require("bytes" not in expected or actual["bytes"] == expected["bytes"],
            "changed source size: " + str(path))
    return actual


def explicit_pins(value):
    if isinstance(value, dict):
        if isinstance(value.get("path"), str) and isinstance(value.get("sha256"), str):
            yield value
        for child in value.values():
            yield from explicit_pins(child)
    elif isinstance(value, list):
        for child in value:
            yield from explicit_pins(child)


def read_chain(path):
    rows = [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
    previous = "0" * 64
    for i, row in enumerate(rows):
        body = {k: v for k, v in row.items() if k != "record_sha256"}
        digest = hashlib.sha256(json.dumps(body, sort_keys=True, separators=(",", ":"),
                                           allow_nan=False).encode()).hexdigest()
        require(row["sequence"] == i and row["previous_sha256"] == previous
                and row["record_sha256"] == digest, "damaged saved ledger chain")
        previous = digest
    return rows


def accounting(config, rows, supplemental_rows):
    """Mirror saved reservation semantics, without running ledger code."""
    stages = []
    pending = None
    for row in rows:
        data = row["data"]
        if row["event"] == "initialized":
            require(pending is None and not stages, "unexpected ledger initialization")
        elif row["event"] == "attempt-intent":
            require(pending is None, "unfinished prior stage")
            pending = data
        elif row["event"] == "attempt-finish":
            require(pending is not None and data["attempt"] == pending["attempt"],
                    "finish does not match stage")
            reserve = pending["reservation"]
            failed = data["status"] == "failed"
            elapsed = data["active_seconds"]
            observed = data["observed_native_applies"]
            stages.append(dict(stage=pending["stage"], phase=reserve["phase"],
                reservation=reserve, finish=data, finish_record_sha256=row["record_sha256"],
                charged_seconds=max(elapsed, reserve["seconds"]) if failed else elapsed,
                charged_native_applies=max(observed, reserve["native_applies"]) if failed else observed))
            pending = None
        else:
            fail("unexpected ledger event")
    require(pending is None and len(stages) == 4, "exact four ended v2 stages required")
    require([r["event"] for r in supplemental_rows] == ["intent", "finish"],
            "exact ended supplemental attempt required")
    supplemental = supplemental_rows[-1]["data"]
    require(supplemental["status"] == "completed", "supplemental success required")
    carried = config["recovery_parent"]
    native = carried["charged_native_seconds"] + sum(s["charged_seconds"] for s in stages if s["phase"] == "native")
    analysis_before = carried["analysis_charged_seconds"] + sum(s["charged_seconds"] for s in stages if s["phase"] == "analysis")
    require(analysis_before == supplemental["shared_analysis_charged_before"], "supplemental analysis baseline differs")
    analysis = analysis_before + supplemental["charged_seconds"]
    require(analysis == supplemental["shared_analysis_charged_after"], "supplemental charge differs")
    require(carried["observed_native_applies"] is None, "v1 unknown observation must remain unknown")
    observed_v2 = sum(s["finish"]["observed_native_applies"] for s in stages)
    charged_calls = carried["charged_native_applies"] + sum(s["charged_native_applies"] for s in stages)
    return dict(scope="Public-input-binding v1, v2 and supplemental checker only; prior research separate",
        stages=stages, v1_preserved=carried, supplemental_finish=supplemental,
        v2_final_chain=rows[-1]["record_sha256"], supplemental_final_chain=supplemental_rows[-1]["record_sha256"],
        cumulative=dict(charged_native_applies=charged_calls, observed_native_applies=None,
            observed_v2_native_applies=observed_v2,
            v1_static_forensic_engine_applies=carried["supplemental_static_engine_apply_calls"],
            static_forensic_is_not_journal_observation_or_credit=True,
            native_charged_seconds=native, analysis_charged_seconds=analysis,
            total_charged_seconds=native + analysis,
            neural_forwards=0, optimizer_updates=0, numerical_fits=0, paid_jobs=0, paid_spend_usd=0),
        prior_research_scope=config["prior_exposure"], prior_charged_seconds=config["prior_charged_seconds"],
        accounting_note="Failed reservations remain charged; no credit, reset or reconstructed observed native total.")


def write_new(path, value):
    with Path(path).open("xb") as stream:
        stream.write(encoded(value))


def build(campaign, repo, out):
    campaign = Path(campaign).resolve(strict=True)
    repo = Path(repo).resolve(strict=True)
    out = Path(out).resolve()
    require(not out.exists(), "new output directory required")
    v1 = campaign.with_name("public-input-binding-v1")
    own = repo / "bots/jepa/own_deck"
    report = own / "PUBLIC_INPUT_BINDING_RESULTS.md"
    audit_path = campaign / "independent-verification-supplemental.json"
    require(pin(audit_path)["sha256"] == EXPECTED_AUDIT, "supplemental evidence differs")
    require(pin(report)["sha256"] == EXPECTED_REPORT, "final reviewed report differs")
    require(pin(campaign / "campaign-ledger.jsonl")["sha256"] == EXPECTED_LEDGER, "ended v2 ledger differs")
    config = load(campaign / "campaign-config.json")
    plan = load(campaign / "native-plan.json")
    audit = load(audit_path)
    predictions = load(campaign / "predictions.json")
    raw = load(campaign / "native-attempt-1/native-receipt.json")
    rows = read_chain(campaign / "campaign-ledger.jsonl")
    supp = read_chain(campaign / "supplemental-verification-ledger.jsonl")
    require(rows[-1]["record_sha256"] == EXPECTED_CHAIN and supp[-1]["record_sha256"] == EXPECTED_SUPP_CHAIN,
            "final chains differ")
    require(audit["status"] == "PASS" and len(audit["records"]) == 16 and len(audit["legacy_collisions"]) == 72,
            "expected verified evidence required")
    original_failure = load(campaign / "analysis-verification-receipt.json")
    require(original_failure["status"] == "failed" and original_failure["error"] == dict(type="KeyError", message="'damage'"),
            "original failed checker must remain explicit")
    protected = load(campaign / "protected-after.json")
    tests = load(campaign / "focused-checks.json")
    require(protected["status"] == "PASS" and tests["status"] == "PASS", "saved verification receipts required")

    # Preserve every raw campaign file and explicit pinned dependency from the
    # frozen configs/plans/descriptors/protection receipts. No unbounded traversal.
    sources = {}
    documents = []
    for directory in (v1, campaign):
        for path in sorted(directory.rglob("*")):
            if path.is_file() and path != Path(__file__).resolve() and not path.is_relative_to(out) and path.suffix in (".json", ".jsonl", ".log", ".py", ".empty-rejected-stdout"):
                sources[str(path.resolve())] = pin(path)
                if path.suffix == ".json":
                    documents.append(path)
    # Old prelaunch manifests were snapshotted away from their project roots.
    # Resolve an exact saved byte match without pretending the original path is
    # still current. Two unexecuted historical source declarations can remain
    # unresolved; executed config dependencies may never do so.
    candidates = list(sources.values())
    for directory in (own / "public_input_binding_collector", own / "public_input_binding_recovery_collector"):
        candidates.extend(pin(p) for p in directory.rglob("*") if p.is_file() and "__pycache__" not in str(p))
    by_sha = {p["sha256"]: p for p in candidates}
    historical_pin_resolutions = []
    for path in documents:
        for expected in explicit_pins(load(path)):
            try:
                actual = verify_pin(expected, path.parent)
            except (ValueError, FileNotFoundError):
                actual = by_sha.get(expected["sha256"])
                if actual is None:
                    permitted = {"abb8c97d1ee473ceb6af452d8c9ea6705426c28046c442996122dc38fe2b3105",
                                 "8bc35d50f9cf59b55d6549915f8215fc143e0cd5d05ad3b85665824946c2be4e"}
                    require(expected["sha256"] in permitted and path.parent.name in ("preparation-guard-cleanup-v1", "preparation-accounting-pin-rejection-v1"),
                            "unresolved active source pin: " + expected["path"])
                    historical_pin_resolutions.append(dict(declared_pin=expected, declaring_document=pin(path),
                        status="unresolved-unexecuted-prelaunch-declaration", executed=False,
                        reason="Source amended before frozen executed config; exact earlier bytes not available. No verification implied."))
                    continue
                historical_pin_resolutions.append(dict(declared_pin=expected, declaring_document=pin(path),
                    status="exact-byte-saved-location", saved_pin=actual))
            sources[actual["path"]] = actual
    for path in (v1 / "campaign-config.json", campaign / "campaign-config.json"):
        for expected in explicit_pins(load(path)):
            verify_pin(expected, path.parent)
    sources[str(Path(__file__).resolve())] = pin(__file__)
    for name in ("PUBLIC_INPUT_BINDING_PROTOCOL.md", "PUBLIC_INPUT_BINDING_RECOVERY.md",
                 "public_input_binding_export.py", "public_input_binding_publication.py"):
        sources[str((own / name).resolve())] = pin(own / name)
    before = dict(sources)
    common = dict(schema="public-input-binding-dashboard-view/1", scientific_numbers_recomputed=False,
        semantic_validated=False, neural_forwards=0, native_applies=0, optimizer_updates=0,
        numerical_fits=0, provenance=dict(builder=pin(__file__), inputs=[pin(p) for p in (
            audit_path, campaign / "predictions.json", campaign / "native-plan.json",
            campaign / "campaign-config.json", campaign / "campaign-ledger.jsonl",
            campaign / "supplemental-verification-ledger.jsonl")]), limitations=audit["limitations"])
    def view(kind, **values):
        return dict(common, kind=kind, **values)
    source_refs = dict(config=pin(campaign / "campaign-config.json"), plan=pin(campaign / "native-plan.json"),
        protocol=pin(own / "PUBLIC_INPUT_BINDING_PROTOCOL.md"), recovery_protocol=pin(own / "PUBLIC_INPUT_BINDING_RECOVERY.md"),
        coverage=pin(v1 / "coverage-contract.json"))
    views = {
        "data": view("data", records=audit["records"], head_input_records=audit["head_input_records"],
            source_records=raw["cases"], native_journal=audit["native_journal"], counts=audit["counts"]),
        "scores": view("scores", controls=audit["controls"], counts=audit["counts"], mechanic_primary=audit["mechanic_primary"],
            legacy_unknown_scope="Zero coverage is this strict control's abstention, not a maximum-capability claim.",
            native_roots=16, source_programs=2, source_train_codes=[], statistical_independence_not_claimed=True),
        "causal-pairs": view("causal-pairs", causal_pairs=audit["causal_pairs"], legacy_collisions=audit["legacy_collisions"],
            comparisons_are_not_independent_samples=True,
            floor_scope="Balanced pair absolute-error floors apply to an old-input-only deterministic predictor; no fit or generalization result."),
        "encoding-controls": view("encoding-controls", projectors=[dict(world_id=r["world_id"],
            projector=r["predictions"]["bound"]["projector"]) for r in predictions["cases"]],
            heads=predictions["heads"], controls=predictions["controls"], role_contract=plan["raw_abi"],
            candidate_order=plan["candidate_order"], control_transformations=audit["control_transformations"],
            after_only_parent_proof=audit["after_only_parent_proof"], predictor_source_audit=audit["predictor_source_audit"]),
        "contract": view("contract", references=source_refs, frozen_config=config, frozen_plan=plan,
            coverage_contract=load(v1 / "coverage-contract.json"), controls_frozen_before_native=config["controls_frozen_before_native"],
            fresh_source_codes=config["fresh_source_codes"], train_codes=config["train_codes"]),
        "verification": view("verification", original_checker=dict(status="FAIL", receipt=original_failure,
            source=pin(own / "public_input_binding_verify.py")), supplemental=dict(status=audit["status"],
            result=pin(audit_path), checker_repair=audit["checker_repair"], source=audit["source"],
            catalogue_unmodified=audit["catalogue_unmodified"], native_journal=audit["native_journal"]),
            protected_after=protected, focused_checks=tests),
        "accounting": view("accounting", **accounting(config, rows, supp)),
        "failures": view("failures", v1_startup=load(v1 / "startup-failure-audit.json"),
            v1_native_receipt=load(v1 / "native-attempt-1/supervisor-receipt.json"),
            original_v2_checker=original_failure, supplemental_repair=audit["checker_repair"],
            preservation="Original failure records and conservative charges remain unchanged; supplemental success does not replace them.")}
    out.mkdir(parents=True, exist_ok=False)
    for name, value in views.items():
        write_new(out / (name + ".json"), value)
    artifacts = []
    for name in SCIENCE:
        role = "verification" if name == "failures" else name
        artifacts.append(dict(id=name, role=role, **pin(out / (name + ".json"))))
    artifacts.append(dict(id="report", role="report", **pin(report)))
    for name in ("protected-after", "focused-checks"):
        artifacts.append(dict(id=name, role="verification", **pin(campaign / (name + ".json"))))
    for i, expected in enumerate(sorted(sources.values(), key=lambda p: p["path"])):
        artifacts.append(dict(id="raw-%04d-%s" % (i, expected["sha256"][:12]), role="source", **expected))
    for expected in before.values():
        require(pin(expected["path"]) == expected, "source changed while making views")
    descriptor = dict(schema="public-input-binding-explicit-artifact-list/1", artifacts=artifacts,
        study_artifact_ids=[*SCIENCE, "report"], root_index_registry_artifact_id="public-input-binding",
        source_pin_scope="All raw v1/v2 campaign files plus every explicit pin in those JSON documents and every direct config source pin.",
        provenance=dict(historical_prelaunch_pin_resolutions=historical_pin_resolutions),
        scientific_execution=dict(native_applies=0, neural_forwards=0, optimizer_updates=0, numerical_fits=0))
    write_new(out / "export-artifacts.json", descriptor)
    receipt = dict(schema="public-input-binding-field-copy-receipt/1", status="complete-field-copies-no-science",
        builder=pin(__file__), artifact_manifest=pin(out / "export-artifacts.json"),
        outputs=[pin(out / (name + ".json")) for name in SCIENCE], report=pin(report),
        raw_source_files=len(sources), explicit_artifacts=len(artifacts),
        accounting=views["accounting"]["cumulative"], archive_created=False)
    write_new(out / "field-copy-receipt.json", receipt)
    return receipt


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--campaign", type=Path, default=Path(__file__).resolve().parent)
    parser.add_argument("--repo", type=Path, default=Path(__file__).resolve().parents[2] / "holocron-deck-context")
    parser.add_argument("--out", type=Path, required=True)
    args = parser.parse_args()
    print(json.dumps(build(args.campaign, args.repo, args.out), indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
