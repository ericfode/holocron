[workspace]
members = ["crates/kessel", "crates/kessel-wasm"]
resolver = "2"

[profile.release]
debug = false
lto = "thin"

# Local Rust iteration: optimize runtime-heavy tests while retaining debug checks.
# A separate profile keeps ordinary dev/release artifacts reusable too.
[profile.rust-loop]
inherits = "dev"
opt-level = 2
debug = 1
debug-assertions = true
overflow-checks = true
