"""Freeze fixed source/command pins; does not initialize or execute any stage."""
import datetime
import json
from pathlib import Path
import subprocess
import sys

CAMPAIGN=Path(__file__).resolve().parent
TASK=CAMPAIGN.parents[1]
REPO=TASK/'holocron-deck-context'
HERE=REPO/'bots/jepa/own_deck'
sys.path.insert(0,str(HERE))
import public_input_binding_accounting as A

def main():
    destination=CAMPAIGN/'campaign-config.json'
    if destination.exists():raise FileExistsError('preserve frozen config')
    git=lambda *args:subprocess.check_output(['git','-C',str(REPO),*args],text=True).strip()
    plan=json.loads((CAMPAIGN/'native-plan.json').read_text())
    native=CAMPAIGN/'native-attempt-1/native-receipt.json'
    journal=CAMPAIGN/'native-attempt-1/native-transitions.jsonl'
    prediction=CAMPAIGN/'predictions.json'
    verification=CAMPAIGN/'independent-verification.json'
    commands={
      'analysis-controls':dict(argv=[str(HERE/'public_input_binding.py'),'--receipt',str(native),'--catalog',str(HERE/'public_input_binding_collector/fixtures/whole-rows.json'),'--out',str(prediction)],outputs=[str(prediction)]),
      'analysis-verification':dict(argv=[str(HERE/'public_input_binding_verify.py'),'--plan',str(CAMPAIGN/'native-plan.json'),'--receipt',str(native),'--journal',str(journal),'--predictions',str(prediction),'--predictor-source',str(HERE/'public_input_binding.py'),'--out',str(verification)],outputs=[str(verification)])
    }
    paths=[Path(__file__),CAMPAIGN/'native-plan.json',CAMPAIGN/'coverage-contract.json',CAMPAIGN/'protected-before.json',HERE/'PUBLIC_INPUT_BINDING_PROTOCOL.md']
    modules=['public_input_binding','public_input_binding_accounting','public_input_binding_analysis','public_input_binding_native_plan','public_input_binding_verify','public_input_binding_export']
    paths.extend(HERE/(name+'.py')for name in modules)
    paths.extend(HERE/('test_'+name+'.py')for name in modules)
    paths.extend(p for p in (HERE/'public_input_binding_collector').rglob('*')if p.is_file()and '__pycache__'not in p.parts)
    paths.extend(HERE/name for name in ['effect_identifiability_fit.py','actual_corpus_native_plan.py','grounded_contrast_data.py','whole_card_encoder.py'])
    paths.extend(Path(pin['path'])for pin in plan['source_pins'])
    paths.extend(Path(pin['path'])for pin in A.PARENT_PINS)
    protected=json.loads((CAMPAIGN/'protected-before.json').read_text())
    paths.extend(Path(pin['path'])for pin in protected['protected_files'])
    value=dict(schema='jepa-public-input-binding-config/1',created_at_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
      source_commit=git('rev-parse','HEAD'),source_tree=git('rev-parse','HEAD^{tree}'),
      limits=A.CAPS,parent_pins=A.PARENT_PINS,parent_final_chains=A.PARENT_CHAINS,prior_exposure=A.PRIOR_EXPOSURE,
      prior_charged_seconds=A.verify_parents(),analysis_stages=A.ANALYSIS_STAGES,analysis_commands=commands,
      pins=[A.pin(p)for p in sorted(set(p.resolve()for p in paths))],
      controls_frozen_before_native=True,train_codes=[],fresh_source_codes=['LAW_045','LOF_215'],
      scope='Preinspected intact programs; fresh native public-state sufficiency and actual-endpoint binding only; no training or semantic qualification',
      zero_authorized=dict(neural_forwards=0,optimizer_updates=0,numerical_fits=0,paid_jobs=0),
      native_stage_outputs={'native-build':str(CAMPAIGN/'native-build-1'),'native-collect':str(CAMPAIGN/'native-attempt-1')})
    value['config_sha256']=A.digest(value)
    A.validate_config(value);A.verify_pins(value['pins'])
    with destination.open('x')as f:json.dump(value,f,indent=2,allow_nan=False);f.write('\n')
    print(json.dumps(dict(config=A.pin(destination),source_commit=value['source_commit'],pins=len(value['pins']),native_applies=0,neural_forwards=0)))

if __name__=='__main__':main()
