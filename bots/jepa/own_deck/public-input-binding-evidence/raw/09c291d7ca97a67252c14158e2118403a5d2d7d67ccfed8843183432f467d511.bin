[package]
name = "kessel"
description = "Deterministic Star Wars Unlimited rules simulator and endgame prover for a checked card subset"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
flate2 = "1"
sha2 = "0.10"

[target.'cfg(target_arch = "wasm32")'.dependencies]
web-time = "=1.1.0"

[build-dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"

[dev-dependencies]
# Parse architecture checks as Rust, so comments and string fixtures are not edges.
syn = { version = "3", features = ["full", "visit"] }
