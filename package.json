{
  "name": "holocron",
  "private": true,
  "description": "Bots and research for the SWU Arena: every bot, the evaluators and learning code, deck building, analysis, and the Karabast player",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test engine/test/*.test.js bots/test/*.test.js lab/test/*.test.js karabast/test/*.test.js karabast/importer/test/*.test.js",
    "test:py": "python3 -m unittest discover -s bots/python",
    "analysis:test": "npm --prefix lab/analysis test",
    "random": "node engine/random-run.js",
    "ladder": "node lab/runners/ladder.js",
    "realdeck:test": "node lab/analysis/realdeck/bot-test.js",
    "analyze": "node lab/analysis/analyze.js",
    "analysis:report": "node lab/analysis/report.js",
    "analysis:fitness": "node lab/analysis/fitness.js",
    "meta": "node lab/meta/analyze.js",
    "lisp:build": "sbcl --non-interactive --load bots/lisp/build.lisp",
    "lisp:test": "sbcl --script bots/lisp/test.lisp"
  },
  "devDependencies": {
    "wabt": "1.0.39"
  }
}
